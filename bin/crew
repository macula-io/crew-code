#!/usr/bin/env bash
# crew: bring crew members up on their own mesh key.
#
#   crew up [--fresh] [Name...]
#                              every member on the roster (or only the ones named) that is not
#                              running, one kitty tab each
#   crew start <Name> [--fresh]
#                              one member headless: a detached tmux session, no kitty needed
#                              (attach with tmux attach -t crew-<name>)
#   crew stop <Name>           stop a member cleanly: its own process group only
#   crew restart <Name> [--fresh]
#                              stop the member if it runs, then start it headless
#   crew <Name> [--fresh] [--tab]
#                              one member in THIS terminal (resumes its last session unless
#                              --fresh); --tab opens it in a new kitty tab instead
#   crew rename <Old> <New>    move key, role card and offline beats to a new name
#   crew ls                    roster, liveness, live agent/macula-mcp counts, and the session a resume would open
#   crew roster                write ~/.claude/crew/roster.json: every member's mesh node id (done before every launch)
#
# Each session runs claude with CREW_NAME=<Name>, MACULA_MCP_AGENT=<name> and -n <Name>.
# Each session runs on its model: CREW_MODEL if set, else the member's own entry in the crew plugin's
# member_models setting, else its worker_model setting, else claude-opus-5-5.
# A member whose model is an OpenCode model (provider/model, e.g. Ceres:deepseek/deepseek-v4-pro in
# member_models) runs on OpenCode on that model (hosts/opencode/README.md). CREW_AGENT=opencode runs any
# member on OpenCode, on CREW_OPENCODE_MODEL if set, else OpenCode's own default model:
#   CREW_AGENT=opencode crew <Name> [--fresh] [--tab]
# Set CREW_DRY_RUN=1 to print the launch instead of running it.
# Set CREW_HOLD=1 to start sessions on hold: they read their card and handover, then wait.
set -euo pipefail

# This script's own path: the sessions it starts carry it as CREW_BIN, so the crew_restart tool
# on both hosts restarts members through the same launcher (#24).
SELF="$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")"
SESSIONS="${HOME}/.claude/sessions"
BEATS="${HOME}/.claude/crew"
PROJECTS="${HOME}/.claude/projects"
KEYS="${HOME}/.config/macula-mcp/keys"
# Where headless starts keep their run records (pid, process group, tmux session): what stop kills (#24).
RUNS="${BEATS}/run"
# Where member sessions start. Override with CREW_WORKDIR.
WORKDIR="${CREW_WORKDIR:-${HOME}}"
# Absolute, for launch and for the OpenCode plugin's own-location comparison (#23): a relative CREW_WORKDIR
# resolves once, here, against this invocation's directory.
WORKDIR="$(cd "${WORKDIR}" 2>/dev/null && pwd || printf '%s' "${WORKDIR}")"
# The session that coordinates the crew: it has a handover, not a role card.
SUPERVISOR="${CREW_SUPERVISOR:-Supervisor}"
LIVE_WINDOW_S=600
# The crew plugin's settings, as /config writes them.
SETTINGS="${HOME}/.claude/settings.json"
DEFAULT_MODEL=claude-opus-5-5
# The coding agent every member runs on, when set: claude or opencode. Unset, each member's own (agent_for).
AGENT="${CREW_AGENT:-}"
# The OpenCode plugin that puts an OpenCode member on the dashboard, next to this script.
OPENCODE_PLUGIN="${CREW_OPENCODE_PLUGIN:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)/hosts/opencode}"

die() { echo "crew: $*" >&2; exit 1; }

case "${AGENT}" in
    "" | claude | opencode) ;;
    *) die "CREW_AGENT is '${AGENT}': it is claude or opencode" ;;
esac

# One of the crew plugin's settings, or nothing.
crew_option() {
    [[ -f "${SETTINGS}" ]] || return 0
    jq -r --arg k "$1" '.pluginConfigs.crew.options[$k] // empty' "${SETTINGS}" 2>/dev/null || true
}

# The model a member's session runs on, fresh or resumed (see the header).
model_for() {
    local name="$1" own worker
    [[ -n "${CREW_MODEL:-}" ]] && { echo "${CREW_MODEL}"; return 0; }
    own="$(crew_option member_models | tr ',' '\n' | awk -F: -v n="${name}" '
        { k = $1; v = $2; gsub(/^[ \t]+|[ \t]+$/, "", k); gsub(/^[ \t]+|[ \t]+$/, "", v)
          if (tolower(k) == tolower(n) && v != "") { print v; exit } }')"
    [[ -n "${own}" ]] && { echo "${own}"; return 0; }
    worker="$(crew_option worker_model)"
    echo "${worker:-${DEFAULT_MODEL}}"
}

# OpenCode names its models provider/model; a Claude model id has no slash.
is_opencode_model() { [[ "$1" == */* ]]; }

# The coding agent a member runs on: CREW_AGENT, else opencode for a member on an OpenCode model, else claude.
agent_for() {
    [[ -n "${CREW_AGENT:-}" ]] && { echo "${CREW_AGENT}"; return 0; }
    is_opencode_model "$(model_for "$1")" && { echo opencode; return 0; }
    echo claude
}

# The model an OpenCode member runs on: CREW_OPENCODE_MODEL, else its own OpenCode model, else OpenCode's default.
opencode_model_for() {
    local model
    [[ -n "${CREW_OPENCODE_MODEL:-}" ]] && { echo "${CREW_OPENCODE_MODEL}"; return 0; }
    model="$(model_for "$1")"
    is_opencode_model "${model}" && echo "${model}"
    return 0
}

# The roster: every ROLE card, plus the supervisor.
roster() {
    {
        echo "${SUPERVISOR}"
        for card in "${SESSIONS}"/ROLE_*.md; do
            [[ -e "${card}" ]] || continue
            card="${card##*/ROLE_}"
            echo "${card%.md}"
        done
    } | awk '!seen[$0]++'
}

valid_name() { [[ "$1" =~ ^[A-Za-z0-9_][A-Za-z0-9_-]{0,63}$ ]]; }

lower() { tr '[:upper:]' '[:lower:]' <<<"$1"; }

# Newest beat for a name: "<sessionId> <state> <beatAt seconds>", or nothing.
last_beat() {
    local name="$1"
    [[ -d "${BEATS}" ]] || return 0
    find "${BEATS}" -maxdepth 1 -name '*.json' -print0 \
        | xargs -0 -r jq -r --arg n "${name}" \
            'select(.name == $n) | "\(.beatAt // 0) \(.sessionId) \(.state)"' 2>/dev/null \
        | sort -n | tail -1 | awk '{ printf "%s %s %d\n", $2, $3, $1 / 1000 }'
}

boot_time() { awk '/^btime /{ print $2 }' /proc/stat; }

# Live = a recent, non-offline beat written since this boot. A beat from before a
# reboot is stale whatever its age: no process survived to write it.
is_live() {
    local beat sid state at
    beat="$(last_beat "$1")"
    [[ -n "${beat}" ]] || return 1
    read -r sid state at <<<"${beat}"
    [[ "${state}" != offline ]] && ((at >= $(boot_time))) && (($(date +%s) - at < LIVE_WINDOW_S)) || return 1
    # An OpenCode member that exited without its offline beat (killed, crashed) leaves a fresh one behind:
    # it is live only while an opencode process with its CREW_NAME runs.
    [[ "$(beat_agent "${sid}")" != opencode ]] || opencode_running "$1"
}

# The CREW_NAME from a process's NUL-separated environment, if it has one. Bash-native (mapfile), so a
# long environment can never SIGPIPE a reader mid-scan. 2>/dev/null comes before the input redirect:
# bash reports the input-redirect failure before the stderr redirect applies (found live, #24a).
crew_name_of() {
    local -a entries=()
    mapfile -d '' -t entries 2>/dev/null <"$1" || true
    local entry
    for entry in "${entries[@]}"; do
        [[ "${entry}" == CREW_NAME=* ]] && { printf '%s\n' "${entry#CREW_NAME=}"; return 0; }
    done
    return 1
}

# Whether an opencode process started for this member (CREW_NAME=<name> in its environment) still runs.
opencode_running() {
    local environ name cmd
    for environ in /proc/[0-9]*/environ; do
        name="$(crew_name_of "${environ}")" || continue
        [[ "${name}" == "$1" ]] || continue
        cmd="$({ tr '\0' ' ' <"${environ%/environ}/cmdline"; } 2>/dev/null)"
        [[ "${cmd}" == *opencode* ]] && return 0
    done
    return 1
}

# Every crew process on this host, one line each: "<CREW_NAME> <pid> agent|macula". One pass over /proc,
# keyed by the CREW_NAME the launcher puts in every member's environment; the kind comes from the
# command line (a member's agent, or a macula-mcp server). The `npm exec` wrapper that fronts a
# macula-mcp and OpenCode's `serve --stdio` child are not the process the owner counts, so they are
# left out.
all_processes() {
    local environ pid name cmdline
    for environ in /proc/[0-9]*/environ; do
        [[ -r "${environ}" ]] || continue
        name="$(crew_name_of "${environ}")" || continue
        pid="${environ%/environ}"; pid="${pid##*/}"
        cmdline="$({ tr '\0' ' ' <"/proc/${pid}/cmdline"; } 2>/dev/null)"
        case "${cmdline}" in
            *serve\ --stdio*) : ;;
            *npm\ exec*macula-mcp* | *npm-cli.js*macula-mcp*) : ;;
            *macula-mcp*) printf '%s %s macula\n' "${name}" "${pid}" ;;
            *claude* | *opencode\ --standalone*) printf '%s %s agent\n' "${name}" "${pid}" ;;
        esac
    done
}

# The tmux session a headless member runs in, and the run record a headless start leaves behind.
tmux_session() { printf 'crew-%s\n' "$(lower "$1")"; }
run_file() { printf '%s/%s.json\n' "${RUNS}" "$1"; }

# The pid of a member's agent process: the run record's pid when it is still that member's process,
# else the first agent process whose CREW_NAME is the member. Identity, never an image or name pattern.
agent_pid_of() {
    local name="$1" record pid
    record="$(run_file "${name}")"
    if [[ -f "${record}" ]]; then
        pid="$(jq -r '.pid // empty' "${record}" 2>/dev/null || true)"
        if [[ -n "${pid}" && -r "/proc/${pid}/environ" ]] && [[ "$(crew_name_of "/proc/${pid}/environ")" == "${name}" ]]; then
            printf '%s\n' "${pid}"
            return 0
        fi
    fi
    # awk reads every line (an early exit can SIGPIPE the scan under pipefail); the first match is
    # taken below, in this shell.
    local found
    found="$(all_processes | awk -v n="${name}" '$1 == n && $3 == "agent" { print $2 }')"
    printf '%s\n' "${found%%$'\n'*}"
}

# Whether a headless member's tmux session is up with a living agent in it.
headless_running() {
    tmux has-session -t "$(tmux_session "$1")" 2>/dev/null || return 1
    [[ -n "$(agent_pid_of "$1")" ]]
}

# Stop <Name> cleanly (#24): its own process group only, never a signal by image or name pattern. The
# record a headless start wrote names the pid; a member the owner started by hand (a kitty tab, this
# terminal) is found by its CREW_NAME, and its group is only killed when the agent leads it -- the
# launcher's exec chain makes the agent its own group and session leader everywhere it starts one.
stop_member() {
    local name="$1" record pid pgid session waited=0
    valid_name "${name}" || die "'${name}' is not a plain name (letters, digits, _ and -)"
    record="$(run_file "${name}")"
    session="$(jq -r '.session // empty' "${record}" 2>/dev/null || true)"
    pid="$(agent_pid_of "${name}")"
    if [[ -z "${pid}" ]]; then
        tmux kill-session -t "$(tmux_session "${name}")" 2>/dev/null || true
        rm -f "${record}"
        echo "${name}: not running"
        return 0
    fi
    pgid="$(ps -o pgid= -p "${pid}" 2>/dev/null | tr -d ' ')"
    if [[ -z "${pgid}" || "${pgid}" == 1 || "${pgid}" == "$(ps -o pgid= -p $$ | tr -d ' ')" ]]; then
        die "refusing to stop ${name}: agent pid ${pid} runs in process group ${pgid:-none}, not its own"
    fi
    echo "${name}: stopping process group ${pgid} (agent pid ${pid})"
    kill -TERM -- "-${pgid}" 2>/dev/null || true
    while [[ -d "/proc/${pid}" ]] && (( waited < 100 )); do
        sleep 0.1
        waited=$((waited + 1))
    done
    if [[ -d "/proc/${pid}" ]]; then
        echo "${name}: still up after 10s; SIGKILL"
        kill -KILL -- "-${pgid}" 2>/dev/null || true
        sleep 0.5
    fi
    [[ -n "${session}" ]] && tmux kill-session -t "${session}" 2>/dev/null || true
    # A kitty tab the member ran in shows a dead process; close the one titled for it (its own, the
    # launcher set that title) so a later start does not read the corpse as "already running".
    command -v kitty >/dev/null 2>&1 && kitty @ close-window --match "title:^${name}$" >/dev/null 2>&1 || true
    rm -f "${record}"
    if [[ -d "/proc/${pid}" ]]; then
        die "${name}: would not stop (agent pid ${pid} still runs)"
    fi
    echo "${name}: stopped"
}

transcript_of() {
    find "${PROJECTS}" -maxdepth 2 -name "$1.jsonl" -print -quit 2>/dev/null
}

# The directory a session was started in: claude --resume finds it only from there.
cwd_of() {
    grep -m1 -o '"cwd":"[^"]*"' "$1" | sed 's/^"cwd":"//; s/"$//'
}

latest_handover() {
    find "${SESSIONS}" -maxdepth 1 -name "HANDOVER_*_$1.md" -print 2>/dev/null | sort | tail -1
}

# The board loop itself is in every session's instructions (the crew mod's board rules), so
# the launcher only says to work the board. One copy of the rules, in the mod.
BOARD_LINE="Then work the board, as the crew board rules in your instructions describe."
# On hold (CREW_HOLD=1) a session takes no work until it is told to: it parks itself and waits.
HOLD_LINE="You are on hold: do not start work and do not claim cards. Call crew_park with parked 1 and the reason \"started on hold\", tell the ${SUPERVISOR} in one line that you are up, then end your turn and wait until the ${SUPERVISOR} or the owner tells you to resume."
[[ -n "${CREW_HOLD:-}" ]] && BOARD_LINE="${HOLD_LINE}"

fresh_prompt() {
    local name="$1" card="${SESSIONS}/ROLE_$1.md" handover
    handover="$(latest_handover "${name}")"
    local text="You are ${name}. The crew launcher started this session fresh."
    [[ -e "${card}" ]] && text+=" Read your role card ${card}."
    [[ -n "${handover}" ]] && text+=" Read your latest handover ${handover}."
    text+=" ${BOARD_LINE}"
    echo "${text}"
}

# A resumed session already has its context; it only needs telling to work the board.
resume_prompt() {
    echo "You are $1. The crew launcher resumed this session. Read any messages that came in for you. ${BOARD_LINE}"
}

# The OpenCode config a member runs with: the crew plugin, its own macula server, its model. The macula entry
# is complete: OpenCode drops an inline entry without a command and runs the global config's one instead, so
# every member would share that config's identity. A complete entry replaces it, environment and all, and
# MACULA_MCP_AGENT keys the server by the member's name (agent-<name>.key, created on first start), as for a
# Claude member.
# It ships disabled (#23): OpenCode connects MCP servers per location (a directory), so an enabled entry runs
# one macula-mcp per directory the member ever touches, and the copies flap each other off the station under
# one identity. The plugin enables this single entry in the member's own directory only (CREW_WORKDIR).
opencode_config() {
    jq -cn --arg plugin "file://${OPENCODE_PLUGIN}" --arg agent "$1" --arg pkg "${MACULA_MCP_PKG}" --arg model "$2" \
        '{plugins: [$plugin], mcp: {macula: {type: "local", command: ["npx", "-y", "-p", $pkg, "macula-mcp"], environment: {MACULA_MCP_AGENT: $agent}, disabled: true}}}
         + (if $model == "" then {} else {model: $model} end)'
}

# The coding agent that wrote a session's beat: opencode, or claude for a beat that names none.
beat_agent() {
    jq -r '.agent // "claude"' "${BEATS}/$1.json" 2>/dev/null || echo claude
}

# The argv a member's agent runs with: <Name>, then the agent's own arguments. Sets CMD. The
# interactive shell matches how kitty launches members (no inherited secrets), and CREW_BIN lets the
# crew_restart tool on either host restart members through this same launcher (#24).
build_agent_cmd() {
    local name="$1"
    shift
    local agent model
    agent="$(lower "${name}")"
    model="$(model_for "${name}")"
    CMD=("${SHELL:-/usr/bin/zsh}" -ic 'exec "$@"' crew
        env -u MACULA_MCP_IDENTITY -u ANTHROPIC_API_KEY "CREW_NAME=${name}" "CREW_BIN=${SELF}" "MACULA_MCP_AGENT=${agent}" claude --model "${model}" -n "${name}" "$@")
    if [[ "${AGENT}" == opencode ]]; then
        # --standalone: a private server, so the plugin runs in this member's process and reads its
        # CREW_NAME. The member's mesh server and its key go through the config (opencode_config);
        # CREW_WORKDIR tells the plugin which location is the member's own (#23).
        CMD=("${SHELL:-/usr/bin/zsh}" -ic 'exec "$@"' crew
            env -u MACULA_MCP_IDENTITY -u MACULA_MCP_AGENT -u ANTHROPIC_API_KEY "CREW_NAME=${name}" "CREW_SUPERVISOR=${SUPERVISOR}" "CREW_WORKDIR=${WORKDIR}" "CREW_BIN=${SELF}"
            "OPENCODE_CONFIG_CONTENT=$(opencode_config "${agent}" "$(opencode_model_for "${name}")")" opencode --standalone "$@")
    fi
}

# launch <tab|here|detached> <Name> <cwd> <agent args...>: a new kitty tab, exec in this terminal, or
# a detached tmux session (#24) the owner can attach to.
launch() {
    local where="$1" name="$2" cwd="$3"
    shift 3
    build_agent_cmd "${name}" "$@"
    if [[ -n "${CREW_DRY_RUN:-}" ]]; then
        printf '[%s] cd %q &&' "${where}" "${cwd}"
        printf ' %q' "${CMD[@]}"
        printf '\n'
        return 0
    fi
    if [[ "${where}" == here ]]; then
        cd "${cwd}"
        exec "${CMD[@]}"
    fi
    if [[ "${where}" == detached ]]; then
        command -v tmux >/dev/null || die "tmux is not on PATH (a headless start needs it; --tab still opens a kitty tab)"
        local session line pid pgid
        session="$(tmux_session "${name}")"
        # A session without a living agent is a corpse from a crash: replace it.
        tmux kill-session -t "${session}" 2>/dev/null || true
        line="$(printf '%q ' "${CMD[@]}")"
        mkdir -p "${RUNS}"
        tmux new-session -d -s "${session}" -c "${cwd}" -x 220 -y 60 "${line}"
        pid="$(tmux list-panes -t "${session}" -F '#{pane_pid}' 2>/dev/null | head -1)"
        [[ -n "${pid}" ]] || die "${name}: tmux started no pane"
        pgid="$(ps -o pgid= -p "${pid}" 2>/dev/null | tr -d ' ')"
        jq -n --arg name "${name}" --argjson pid "${pid}" --argjson pgid "${pgid:-${pid}}" --arg session "${session}" \
            --arg agent "${AGENT:-claude}" --argjson startedAt "$(date +%s)" \
            '{name: $name, pid: $pid, pgid: $pgid, session: $session, agent: $agent, startedAt: $startedAt}' >"$(run_file "${name}")"
        echo "${name}: started headless in tmux session ${session} (attach: tmux attach -t ${session})"
        return 0
    fi
    # claude sets the terminal title over OSC, which kitty shows as the tab title
    # unless the tab has its own: pin both by the window id launch prints.
    local wid
    wid="$(kitty @ launch --type=tab --cwd="${cwd}" --title="${name}" --tab-title="${name}" -- "${CMD[@]}")"
    kitty @ set-window-title --match "id:${wid}" "${name}"
    kitty @ set-tab-title --match "window_id:${wid}" "${name}"
}

kitty_has_tab() {
    [[ -n "${CREW_DRY_RUN:-}" ]] && return 1
    kitty @ ls 2>/dev/null | jq -e --arg t "$1" '[.[].tabs[] | select(.title == $t)] | length > 0' >/dev/null
}

check_kitty() {
    [[ -n "${CREW_DRY_RUN:-}" ]] && return 0
    command -v kitty >/dev/null || die "kitty is not on PATH"
    kitty @ ls >/dev/null 2>&1 || die "kitty remote control is not reachable: run crew from a kitty window (allow_remote_control yes)"
}

bring_up() {
    local name="$1" mode="$2" where="$3" beat sid transcript cwd
    valid_name "${name}" || die "'${name}' is not a plain name (letters, digits, _ and -)"
    if is_live "${name}" || kitty_has_tab "${name}" || headless_running "${name}"; then
        echo "${name}: already running, left alone"
        return 0
    fi
    adopt_key "${name}"
    # launch and bring_up_opencode see this member's agent through AGENT.
    local AGENT
    AGENT="$(agent_for "${name}")"
    if [[ "${AGENT}" == opencode ]]; then
        bring_up_opencode "${name}" "${mode}" "${where}"
        return 0
    fi
    if [[ "${mode}" == resume ]]; then
        beat="$(last_beat "${name}")"
        sid="${beat%% *}"
        transcript="$([[ -n "${sid}" ]] && transcript_of "${sid}" || true)"
        if [[ -n "${transcript}" ]]; then
            cwd="$(cwd_of "${transcript}")"
            [[ -d "${cwd}" ]] || cwd="${WORKDIR}"
            echo "${name}: resuming ${sid} in ${cwd}"
            launch "${where}" "${name}" "${cwd}" --resume "${sid}" "$(resume_prompt "${name}")"
            return 0
        fi
        echo "${name}: no earlier session found, starting fresh"
    fi
    echo "${name}: fresh session in ${WORKDIR}"
    launch "${where}" "${name}" "${WORKDIR}" "$(fresh_prompt "${name}")"
}

# An OpenCode member: resumes the OpenCode session its last beat names (OpenCode keeps no per-member
# transcript the launcher can read, so it starts in CREW_WORKDIR), else starts fresh. A resume keeps the
# session's stored model, and opencode has no --model flag, so a session on another model than the member
# is configured for starts fresh instead, with the reason (found live after #24a).
bring_up_opencode() {
    local name="$1" mode="$2" where="$3" beat sid want stored
    if [[ "${mode}" == resume ]]; then
        beat="$(last_beat "${name}")"
        sid="${beat%% *}"
        if [[ -n "${sid}" && "$(beat_agent "${sid}")" == opencode ]]; then
            want="$(opencode_model_for "${name}")"
            stored="$(jq -r '.model // empty' "${BEATS}/${sid}.json" 2>/dev/null || true)"
            if [[ -n "${want}" && -n "${stored}" && "${want}" != "${stored}" ]]; then
                echo "${name}: session ${sid} is on ${stored}, not ${want} (a resume keeps its stored model); starting fresh"
            else
                echo "${name}: resuming OpenCode session ${sid} in ${WORKDIR}"
                launch "${where}" "${name}" "${WORKDIR}" --session "${sid}" --prompt "$(resume_prompt "${name}")"
                return 0
            fi
        else
            echo "${name}: no earlier OpenCode session found, starting fresh"
        fi
    fi
    echo "${name}: fresh OpenCode session in ${WORKDIR}"
    launch "${where}" "${name}" "${WORKDIR}" --prompt "$(fresh_prompt "${name}")"
}

list() {
    local name beat sid state at agents maculas
    # One pass over /proc for every member's live process counts.
    local -A AGENTS=() MACULAS=()
    while read -r pname ppid pkind; do
        case "${pkind}" in
            agent) AGENTS["${pname}"]=$(( ${AGENTS["${pname}"]:-0} + 1 )) ;;
            macula) MACULAS["${pname}"]=$(( ${MACULAS["${pname}"]:-0} + 1 )) ;;
        esac
    done < <(all_processes)
    printf '%-11s %-8s %5s %-6s %-36s %s\n' NAME STATE AGENT MACULA "LAST SESSION" KEY
    while read -r name; do
        beat="$(last_beat "${name}")"
        sid=- state=never
        [[ -n "${beat}" ]] && read -r sid state at <<<"${beat}"
        agents="${AGENTS["${name}"]:-0}"
        maculas="${MACULAS["${name}"]:-0}"
        if is_live "${name}"; then
            state=live
        elif (( agents > 0 )); then
            # Processes but no fresh beat: up, off the dashboard.
            state=running
        elif [[ "${state}" == never ]]; then
            state=never
        else
            state=offline
        fi
        local key
        key="$(key_of "${name}")"
        printf '%-11s %-8s %5s %-6s %-36s %s\n' "${name}" "${state}" "${agents}" "${maculas}" "${sid}" "${key:--}"
    done < <(roster)
}

# The key file a member's node id lives in: agent-<name>.key, or, for a member
# started before MACULA_MCP_AGENT, the per-session key its mesh server used
# (named after the session it STARTED in; a /clear keeps the server and the key).
key_of() {
    local lname sid
    lname="$(lower "$1")"
    [[ -e "${KEYS}/agent-${lname}.key" ]] && { echo "agent-${lname}.key"; return 0; }
    find "${BEATS}" -maxdepth 1 -name '*.json' -print0 2>/dev/null \
        | xargs -0 -r jq -r --arg n "$1" 'select(.name == $n) | "\(.beatAt // 0) \(.sessionId)"' 2>/dev/null \
        | sort -rn | while read -r _ sid; do
            [[ -e "${KEYS}/${sid}.key" ]] && { echo "${sid}.key"; break; }
        done
    return 0
}

# A member that ran before MACULA_MCP_AGENT keeps its node id: its last
# per-session key becomes agent-<name>.key before the first agent start.
adopt_key() {
    local key lname
    lname="$(lower "$1")"
    key="$(key_of "$1")"
    [[ -n "${key}" && "${key}" != "agent-${lname}.key" ]] || return 0
    if [[ -n "${CREW_DRY_RUN:-}" ]]; then
        echo "$1: would adopt ${key} as agent-${lname}.key"
        return 0
    fi
    mv -n "${KEYS}/${key}" "${KEYS}/agent-${lname}.key"
    echo "$1: adopted ${key} as agent-${lname}.key (node id kept)"
}

name_in_use() {
    local name="$1" lname
    lname="$(lower "${name}")"
    roster | tr '[:upper:]' '[:lower:]' | grep -qx "${lname}" && return 0
    [[ -e "${KEYS}/agent-${lname}.key" ]] && return 0
    [[ -n "$(last_beat "${name}")" ]] && return 0
    return 1
}

rename() {
    local old="$1" new="$2" lold lnew
    valid_name "${new}" || die "'${new}' is not a plain name (letters, digits, _ and -)"
    lold="$(lower "${old}")"
    lnew="$(lower "${new}")"
    [[ "${lold}" != "${lnew}" ]] || die "'${old}' and '${new}' are the same name"
    roster | grep -qx "${old}" || [[ -n "$(key_of "${old}")" ]] \
        || die "no crew member '${old}' (no role card, no key)"
    name_in_use "${new}" && die "'${new}' is already in use (role card, key or session); pick another name"
    is_live "${old}" && die "${old} is running; stop that session first, its mesh server holds the key"

    local key
    key="$(key_of "${old}")"
    if [[ -n "${key}" ]]; then
        mv -n "${KEYS}/${key}" "${KEYS}/agent-${lnew}.key"
        echo "key:       ${key} -> agent-${lnew}.key (same node id)"
    else
        echo "key:       none found for ${old}; ${new} gets a new one on its first start"
    fi
    if [[ -e "${SESSIONS}/ROLE_${old}.md" ]]; then
        mv -n "${SESSIONS}/ROLE_${old}.md" "${SESSIONS}/ROLE_${new}.md"
        sed -i -E "s/\\b${old}\\b/${new}/g; s/crew:${lold}\\b/crew:${lnew}/g" "${SESSIONS}/ROLE_${new}.md"
        echo "role card: ROLE_${old}.md -> ROLE_${new}.md (name replaced inside)"
    fi
    local moved=0 beat tmp
    while IFS= read -r -d '' beat; do
        [[ "$(jq -r '.name' "${beat}")" == "${old}" ]] || continue
        tmp="$(mktemp "${beat}.XXXX")"
        jq --arg n "${new}" '.name = $n' "${beat}" >"${tmp}" && mv "${tmp}" "${beat}"
        moved=$((moved + 1))
    done < <(find "${BEATS}" -maxdepth 1 -name '*.json' -print0 2>/dev/null)
    echo "sessions:  ${moved} dashboard beat(s) now name ${new}, so 'crew ${new}' resumes them"
    local store
    for store in "${HOME}"/.claude/plugins/store/crew_*.json; do
        [[ -e "${store}" ]] || continue
        tmp="$(mktemp "${store}.XXXX")"
        jq --arg o "${old}" --arg n "${new}" '
            with_entries(
                if .key == "refresh:\($o)" then .key = "refresh:\($n)"
                elif .key == "refreshed:\($o)" then .key = "refreshed:\($n)"
                elif (.key | startswith("name:")) and .value == $o then .value = $n
                else . end)' "${store}" >"${tmp}" && mv "${tmp}" "${store}"
        echo "dashboard: refresh mode and session names in ${store##*/} moved to ${new}"
    done

    echo
    echo "Follow-ups (not done here):"
    echo "- GitHub: rename label crew:${lold} -> crew:${lnew} in every repo that has it; open issues using it:"
    gh search issues --label "crew:${lold}" --state open --json repository,number \
        --jq '.[] | "    \(.repository.nameWithOwner)#\(.number)"' 2>/dev/null || echo "    (gh search failed)"
    echo "- mcl-kanban roster: discharge agent ${lold}, enlist ${lnew}"
    echo "- crew mod: PLANETS in ~/.claude/mods/crew/hooks/register.tsx names ${old}"
    echo "- handovers and session notes naming ${old} (history, left as written):"
    grep -l -w "${old}" "${SESSIONS}"/HANDOVER_*.md 2>/dev/null | sed 's/^/    /' | tail -10 || true
    echo "- memory files naming ${old}:"
    grep -rl -w "${old}" "${HOME}/.claude/projects/-home-rl-work-github-com/memory" 2>/dev/null | sed 's/^/    /' || true
}

usage() { sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

# The macula-mcp release that prints a key's node id (macula-mcp-node-id), and the crew room needs (#18).
MACULA_MCP_PKG="${CREW_MACULA_MCP:-@macula-io/mcp@0.46.1}"

# The node id one member's mesh server uses: the key key_of finds (a member started before named keys keeps its
# old file), else its named key, created now as its server would.
node_id_of() {
    local key lname
    key="$(key_of "$1")"
    lname="$(lower "$1")"
    if [[ -n "${key}" ]]; then
        env -u MACULA_MCP_AGENT "MACULA_MCP_IDENTITY=${KEYS}/${key}" npx -y -p "${MACULA_MCP_PKG}" macula-mcp-node-id
    else
        env -u MACULA_MCP_IDENTITY "MACULA_MCP_AGENT=${lname}" npx -y -p "${MACULA_MCP_PKG}" macula-mcp-node-id
    fi
}

# roster.json: name -> node id for every member, the crew room's only trust anchor (#18). A session delivers a
# room message only from a node id listed here. Written whole, owner-only, then renamed into place.
write_roster() {
    local name id ids=()
    while read -r name; do
        id="$(node_id_of "${name}" 2>/dev/null | tr -d '[:space:]')" || id=""
        [[ "${id}" =~ ^[0-9a-f]{64}$ ]] || { echo "crew: no node id for ${name}; left out of the roster" >&2; continue; }
        ids+=("${name}" "${id}")
    done < <(roster)
    if [[ -n "${CREW_DRY_RUN:-}" ]]; then
        printf 'roster: %s\n' "${ids[*]}"
        return 0
    fi
    mkdir -p "${BEATS}"
    local tmp
    tmp="$(mktemp "${BEATS}/roster.json.XXXX")"
    chmod 600 "${tmp}"
    if ! printf '%s\n' "${ids[@]}" | jq -R . | jq -s '. as $a | reduce range(0; length; 2) as $i ({}; . + {($a[$i]): $a[$i + 1]})' >"${tmp}"; then
        rm -f "${tmp}"
        die "could not write the roster"
    fi
    mv "${tmp}" "${BEATS}/roster.json"
    echo "roster: $(( ${#ids[@]} / 2 )) members in ${BEATS}/roster.json"
}

main() {
    [[ $# -ge 1 ]] || usage 1
    local mode=resume
    case "$1" in
        -h | --help | help) usage 0 ;;
        ls) list ;;
        roster) write_roster ;;
        rename)
            [[ $# -eq 3 ]] || die "usage: crew rename <Old> <New>"
            rename "$2" "$3"
            ;;
        up)
            shift
            [[ "${1:-}" == --fresh ]] && { mode=fresh; shift; }
            check_kitty
            write_roster
            if [[ $# -gt 0 ]]; then
                for name in "$@"; do bring_up "${name}" "${mode}" tab; done
            else
                while read -r name; do bring_up "${name}" "${mode}" tab; done < <(roster)
            fi
            ;;
        start | stop | restart)
            local cmd="$1" name opt have_fresh=0
            shift
            [[ $# -ge 1 ]] || die "usage: crew ${cmd} <Name> [--fresh]"
            name="$1"
            shift
            for opt in "$@"; do
                case "${opt}" in
                    --fresh) have_fresh=1 ;;
                    *) die "unknown option '${opt}' (crew ${cmd} <Name> [--fresh])" ;;
                esac
            done
            [[ "${cmd}" == stop && "${have_fresh}" == 1 ]] && die "crew stop takes no --fresh"
            [[ "${have_fresh}" == 1 ]] && mode=fresh
            case "${cmd}" in
                start)
                    write_roster
                    bring_up "${name}" "${mode}" detached
                    ;;
                stop) stop_member "${name}" ;;
                restart)
                    stop_member "${name}"
                    write_roster
                    bring_up "${name}" "${mode}" detached
                    ;;
            esac
            ;;
        -*) die "unknown option '$1'" ;;
        *)
            local name="$1" where=here opt
            shift
            for opt in "$@"; do
                case "${opt}" in
                    --fresh) mode=fresh ;;
                    --tab) where=tab ;;
                    *) die "unknown option '${opt}' (crew <Name> [--fresh] [--tab])" ;;
                esac
            done
            [[ "${where}" == tab ]] && check_kitty
            write_roster
            bring_up "${name}" "${mode}" "${where}"
            ;;
    esac
}

main "$@"
